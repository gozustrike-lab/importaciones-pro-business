generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// MULTI-TENANT: TENANT (Empresa/Organización)
// ============================================
model Tenant {
  id              String   @id @default(cuid())
  name            String
  ruc             String   @unique
  ownerName       String
  ownerEmail      String
  plan            String   @default("free") // free / pro / enterprise
  isActive        Boolean  @default(true)
  maxUsers        Int      @default(5)
  address         String   @default("")
  city            String   @default("Lima")
  phone           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  products        Product[]
  clients         Client[]
  sales           Sale[]
  nrusConfigs     NRUSConfig[]
  monthlySales    MonthlySales[]
  suppliers       Supplier[]
  shipments       Shipment[]
  dealTrackers    DealTracker[]
}

// ============================================
// MULTI-TENANT: USER (Usuarios del sistema)
// ============================================
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String?
  image           String?
  role            String   @default("TENANT_USER") // SUPER_ADMIN / TENANT_ADMIN / TENANT_USER
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id])
  isActive        Boolean  @default(true)
  lastLogin       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
}

// ============================================
// NEXTAUTH: ACCOUNT (OAuth providers)
// ============================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ============================================
// NEXTAUTH: SESSION
// ============================================
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PRODUCTOS / IMPORTACIONES DESDE EBAY
// ============================================
model Product {
  id              String   @id @default(cuid())

  // Identificación
  purchaseDate    DateTime
  orderNumber     String
  supplier        String   @default("eBay")

  // Logística
  courier         String   @default("")
  trackingId      String   @default("")
  shipperTracking String   @default("") // Tracking corregido/registrado por Shiper (ej: con prefijo GS1-128 postal)
  shipperConfirmed Boolean @default(false) // Confirmado físicamente en almacén por Shiper
  shippingStatus  String   @default("USA")
  estimatedArrival DateTime?
  actualArrival   DateTime?

  // Producto
  description     String
  category        String   @default("")
  model           String   @default("")
  color           String   @default("")
  capacity        String   @default("")
  grade           String   @default("A")
  condition       String   @default("")
  serialNumber    String   @default("")
  quantity        Int      @default(1)

  // Control de Calidad
  screenStatus    String   @default("")
  batteryHealth   String   @default("")
  batteryCycles   Int      @default(0)
  qualityPassed   Boolean  @default(false)
  qualityNotes    String   @default("")

  // Finanzas USD
  purchasePriceUsd  Float
  shippingCostUsd   Float   @default(0)
  advertisingCostUsd Float  @default(0)
  extraCostsUsd     Float   @default(0)
  exchangeRate      Float   @default(3.70)

  // Finanzas PEN (calculados)
  totalCostPen      Float   @default(0)
  taxAmountPen      Float   @default(0)
  adValoremPen      Float   @default(0)
  igvPen            Float   @default(0)
  perceptionPen     Float   @default(0)

  // Venta
  salePricePen      Float   @default(0)
  suggestedPricePen Float   @default(0)
  saleDate          DateTime?
  saleChannel       String   @default("")
  profitPen         Float   @default(0)
  profitMargin      Float   @default(0)

  // Importador & Casillero SUNAT (Bi-RUC Fabio / Peggy)
  importerProfile   String   @default("fabio") // "fabio" | "peggy"
  recipientName     String   @default("")      // "SHIPER FABIO CESAR HERRERA BONILLA" | "SHIPER PEGGY LILIANA BONILLA ORDUNA"
  ebayAccount       String   @default("gozustrike@gmail.com") // Cuenta de eBay utilizada

  // Otros
  notes            String   @default("")
  isArchived       Boolean   @default(false)  // true = embarcado a Perú (oculto en eBay)
  archivedAt       DateTime?                  // Fecha en que se archivó / embarcó a Perú
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Multi-Tenant
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id])

  // Relaciones
  trackingUpdates  TrackingUpdate[]
  qualityChecks    QualityCheck[]
  sales            Sale[]
  supplierId       String?
  supplierRef      Supplier? @relation("ProductSupplierRef", fields: [supplierId], references: [id])
  shipmentId       String?
  shipment         Shipment? @relation(fields: [shipmentId], references: [id])
}

// ============================================
// CLIENTES (CRM)
// ============================================
model Client {
  id              String   @id @default(cuid())
  fullName        String
  dniRuc          String   @default("")
  celular         String   @default("")
  email           String   @default("")
  ciudad          String   @default("")
  direccion       String   @default("")
  notas           String   @default("")
  isFrequent      Boolean  @default(false)
  totalPurchases  Int      @default(0)
  totalSpent      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-Tenant
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  sales           Sale[]
}

// ============================================
// VENTAS (Registro de Ventas)
// ============================================
model Sale {
  id                String   @id @default(cuid())
  saleDate          DateTime @default(now())
  saleChannel       String   @default("")
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id])
  salePricePen      Float
  costAcquisitionPen Float
  costMarketingPen   Float
  costOperativePen   Float
  netProfitPen       Float
  profitMargin       Float
  status            String   @default("Completada")
  paymentMethod     String   @default("")
  warrantyMonths    Int      @default(3)
  warrantyNotes     String   @default("")
  deliveryStatus    String   @default("")
  deliveryDate      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Multi-Tenant
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
}

// ============================================
// TRACKING DE ENVÍOS
// ============================================
model TrackingUpdate {
  id          String   @id @default(cuid())
  productId   String
  status      String
  location    String   @default("")
  description String   @default("")
  timestamp   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================
// CHECKLIST DE CALIDAD / INSPECCIÓN
// ============================================
model QualityCheck {
  id              String   @id @default(cuid())
  productId       String
  screenOk        Boolean @default(false)
  touchscreenOk   Boolean @default(false)
  buttonsOk       Boolean @default(false)
  speakersOk      Boolean @default(false)
  microphoneOk    Boolean @default(false)
  cameraOk        Boolean @default(false)
  portsOk         Boolean @default(false)
  wifiOk          Boolean @default(false)
  bluetoothOk     Boolean @default(false)
  keyboardOk      Boolean @default(false)
  trackpadOk      Boolean @default(false)
  housingOk       Boolean @default(false)
  batteryOk       Boolean @default(false)
  chargerIncluded Boolean @default(false)
  originalBox     Boolean @default(false)
  passed          Boolean  @default(false)
  inspector       String   @default("")
  notes           String   @default("")
  checkedAt       DateTime @default(now())

  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================
// CONFIGURACIÓN NRUS (Nuevo Régimen Único Simplificado)
// ============================================
model NRUSConfig {
  id              String   @id @default(cuid())
  ruc             String   @default("10762026835")
  businessName    String   @default("Importaciones Perú")
  cat1Threshold   Float    @default(5000)
  cat2Threshold   Float    @default(8000)
  igvRate         Float    @default(0.18)
  adValoremRate   Float    @default(0.04)
  perceptionRate  Float    @default(0.10)
  fobExemption    Float    @default(200)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-Tenant
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

// ============================================
// PROVEEDORES (Suppliers)
// ============================================
model Supplier {
  id              String   @id @default(cuid())
  name            String
  website         String   @default("")
  url             String   @default("")          // profile URL (eBay store, AliExpress, etc.)
  contactEmail    String   @default("")
  contactPhone    String   @default("")
  country         String   @default("")
  notes           String   @default("")
  category        String   @default("general")   // electronics, accessories, etc.
  rating          Int      @default(0)            // 0-5 stars
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?

  // Stats
  totalProducts   Int      @default(0)
  totalOrders     Int      @default(0)
  totalSpentUsd   Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  products        Product[]  @relation("ProductSupplierRef")
  supplierLinks   SupplierLink[]
  dealTrackers    DealTracker[]
}

// ============================================
// ENLACES DE PROVEEDORES (Supplier Links)
// ============================================
model SupplierLink {
  id              String   @id @default(cuid())
  title           String
  url             String
  type            String   @default("url")  // url, excel, document, note
  priceUsd        Float    @default(0)
  pricePen        Float    @default(0)
  status          String   @default("active") // active, discontinued, out_of_stock
  notes           String   @default("")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// ============================================
// REGISTRO DE VENTAS MENSUALES (NRUS)
// ============================================
model MonthlySales {
  id              String   @id @default(cuid())
  month           String
  totalSalesPen   Float    @default(0)
  totalCostPen    Float    @default(0)
  category        String   @default("")
  alertLevel      String   @default("none")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-Tenant
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

// ============================================
// EMBARQUES / EXPEDIENTES SHIPPER (Logística)
// ============================================
model Shipment {
  id              String   @id @default(cuid())
  code            String   @unique // ej. EMB-2026-09-14-FABIO-01
  flightDate      DateTime
  flightDayLabel  String   // "LUNES 14 09 2026", "MIERCOLES 16 09 2026", etc.
  importerProfile String   // "fabio" | "peggy"
  consigneeName   String   // FABIO CESAR HERRERA BONILLA / BONILLA ORDUÑA PEGGY LILIANA
  consigneeRuc    String   // 10762026835 / 10091870911
  courierName     String   @default("Shipper")
  awbNumber       String   @default("") // Guía AWB que entrega Shipper por WhatsApp

  // Estado del Embarque: ENVIADO | CONFIRMADO_AWB | EN_VUELO | EN_ADUANAS | EN_LIMA | RECIBIDO
  status          String   @default("ENVIADO")

  totalItems      Int      @default(0)
  totalFobUsd     Float    @default(0)
  isUnder200      Boolean  @default(true)

  emailSentAt     DateTime @default(now())
  confirmedAt     DateTime?
  arrivedLimaAt   DateTime?
  deliveredAt     DateTime?

  notes           String   @default("")
  whatsappNotes   String   @default("") // Notas del chat de WhatsApp con Shipper

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  products        Product[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// BUSCADORES DE OFERTAS & RASTREADORES EBAY
// ============================================
model DealTracker {
  id                    String      @id @default(cuid())
  title                 String      // e.g. "iPad 9na Gen 64GB en Oferta"
  keywords              String      // Palabras clave de búsqueda en eBay
  supplierId            String?     // Proveedor asociado (opcional)
  supplier              Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sellerUsername        String?     // e.g. "itsworthmore" o null para todos
  storeUrl              String?     // URL directa a tienda o búsqueda del proveedor
  category              String      @default("Tablets")
  maxPriceUsd           Float?      // Precio máximo objetivo en USD
  minDiscountPct        Float?      @default(10) // Mínimo descuento % para alertar
  condition             String      @default("Used") // Used, Refurbished, All
  isActive              Boolean     @default(true)
  notificationsEnabled  Boolean     @default(true)
  lastCheckedAt         DateTime?
  lastFoundCount        Int         @default(0)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenantId              String
  tenant                Tenant      @relation(fields: [tenantId], references: [id])

  deals                 TrackedDeal[]
}

model TrackedDeal {
  id                String       @id @default(cuid())
  trackerId         String
  tracker           DealTracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)

  itemId            String       // eBay Item ID
  title             String
  itemUrl           String
  imageUrl          String       @default("")
  sellerUsername    String
  sellerFeedback    String       @default("")

  currentPriceUsd   Float
  originalPriceUsd  Float?
  discountPct       Float?       // e.g. 25.0
  couponCode        String?
  promoDescription  String?
  condition         String       @default("Used")

  isRead            Boolean      @default(false)
  isStarred         Boolean      @default(false)
  foundAt           DateTime     @default(now())
}


